# =============================================================================
# KuppiHub - Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values.
#   cp env.example .env
#
# NEVER commit .env to git. It is already in .gitignore.
# =============================================================================


# -----------------------------------------------------------------------------
# Firebase (Authentication)
# Get these from Firebase Console → Project Settings → Your Apps → Web App
# https://console.firebase.google.com
# -----------------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
# These two are only needed if you enable push notifications (not actively used):
# NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
# NEXT_PUBLIC_FIREBASE_APP_ID=

# Firebase Admin SDK (Server-side - from Service Account JSON)
# Firebase Console → Project Settings → Service Accounts → Generate new private key
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Paste the full private key exactly as it appears in the JSON, with \n line endings
FIREBASE_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n


# -----------------------------------------------------------------------------
# Supabase (Database)
# Get these from Supabase Dashboard → Project Settings → API
# https://supabase.com/dashboard
# -----------------------------------------------------------------------------
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=


# -----------------------------------------------------------------------------
# Cloudflare Turnstile (Bot Protection on resource upload form)
# https://dash.cloudflare.com → Turnstile
# Use 1x00000000000000000000AA (site) / 1x0000000000000000000000000000000AA (secret)
# for local testing (always passes).
# -----------------------------------------------------------------------------
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=


# -----------------------------------------------------------------------------
# MongoDB (Used for kuppi video data)
# https://cloud.mongodb.com
# -----------------------------------------------------------------------------
MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/?appName=cluster0
MONGODB_DB=cluster0


# -----------------------------------------------------------------------------
# Notifications admin + GitHub webhook (optional)
# -----------------------------------------------------------------------------
# Shared secret for service-to-service notification sends (header: x-admin-secret)
NOTIFICATIONS_ADMIN_SECRET=
# GitHub webhook HMAC secret for /api/module-resources/sync-github
GITHUB_WEBHOOK_SECRET=
